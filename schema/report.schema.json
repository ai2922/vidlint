{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ai2922/vidlint/schema/report.schema.json",
  "title": "vidlint report",
  "description": "The defect report emitted by `vidlint --json`. The shape is versioned via `schemaVersion`; additive changes keep the same major version, breaking changes increment it.",
  "type": "object",
  "required": ["schemaVersion", "tool", "input", "media", "config", "summary", "metrics", "timing", "defects"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "description": "Version of this document's shape.",
      "examples": ["1.0"]
    },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "const": "vidlint" },
        "version": { "type": "string" }
      }
    },
    "input": {
      "type": "string",
      "description": "Absolute path to the analysed file. Untrusted: escape it before rendering."
    },
    "media": {
      "type": "object",
      "required": ["formatName", "durationSeconds", "sizeBytes", "bitrate", "video", "audio"],
      "additionalProperties": false,
      "properties": {
        "formatName": { "type": ["string", "null"] },
        "durationSeconds": { "type": ["number", "null"], "minimum": 0 },
        "sizeBytes": { "type": ["integer", "null"], "minimum": 0 },
        "bitrate": { "type": ["number", "null"], "minimum": 0 },
        "video": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["codec", "width", "height", "fps", "rotation"],
              "additionalProperties": false,
              "properties": {
                "codec": { "type": "string" },
                "width": { "type": "integer" },
                "height": { "type": "integer" },
                "fps": { "type": ["number", "null"] },
                "rotation": { "type": "integer" }
              }
            }
          ]
        },
        "audio": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["codec", "sampleRate", "channels"],
              "additionalProperties": false,
              "properties": {
                "codec": { "type": "string" },
                "sampleRate": { "type": ["number", "null"] },
                "channels": { "type": ["number", "null"] }
              }
            }
          ]
        }
      }
    },
    "config": {
      "type": "object",
      "description": "The effective configuration, echoed so a report is reproducible.",
      "required": ["platform", "safeArea", "thresholds"],
      "additionalProperties": false,
      "properties": {
        "platform": { "type": "string" },
        "safeArea": {
          "type": "object",
          "required": ["top", "right", "bottom", "left"],
          "additionalProperties": false,
          "properties": {
            "top": { "type": "number" },
            "right": { "type": "number" },
            "bottom": { "type": "number" },
            "left": { "type": "number" }
          }
        },
        "thresholds": { "type": "object" }
      }
    },
    "summary": {
      "type": "object",
      "required": ["total", "errors", "warnings", "infos", "passed"],
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "infos": { "type": "integer", "minimum": 0 },
        "passed": {
          "type": "boolean",
          "description": "True when there are no error-severity defects. Warnings do not fail a run unless --strict is used."
        }
      }
    },
    "metrics": {
      "type": "object",
      "description": "Raw measurements, for dashboards and for comparing runs. Keys are omitted when the relevant pass did not run.",
      "properties": {
        "audio": { "type": ["object", "null"] },
        "temporal": { "type": ["object", "null"] },
        "layout": { "type": ["object", "null"] }
      }
    },
    "timing": {
      "type": "object",
      "required": ["analysisMs"],
      "additionalProperties": false,
      "properties": {
        "analysisMs": { "type": "integer", "minimum": 0 }
      }
    },
    "defects": {
      "type": "array",
      "description": "Worst-first, then by timecode.",
      "items": { "$ref": "#/$defs/defect" }
    }
  },
  "$defs": {
    "defect": {
      "type": "object",
      "required": ["id", "fingerprint", "severity", "title", "message", "from", "to", "evidence", "hint"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable rule id, e.g. `frozen-with-audio`. Safe to switch on.",
          "enum": [
            "blank-frames",
            "frozen-with-audio",
            "dead-air",
            "flash-risk",
            "mostly-static",
            "no-cuts",
            "audio-gap",
            "silent-audio-track",
            "no-audio-track",
            "too-quiet",
            "too-loud",
            "audio-clipping",
            "safe-area",
            "edge-clipping",
            "low-frame-rate",
            "very-short",
            "rotation-metadata",
            "over-compressed",
            "unusual-codec",
            "invalid-dimensions",
            "no-video-stream"
          ]
        },
        "fingerprint": {
          "type": "string",
          "description": "Stable identity across runs (rule + side + start time), so a caller can tell a persisting defect from a new one."
        },
        "severity": { "enum": ["error", "warn", "info"] },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "from": {
          "type": ["number", "null"],
          "description": "Start of the affected span, in seconds. Null for whole-file findings."
        },
        "to": { "type": ["number", "null"] },
        "evidence": {
          "type": "object",
          "description": "The measurements that triggered the finding. Shape depends on the rule."
        },
        "hint": {
          "type": ["string", "null"],
          "description": "Suggested fix, written for an agent or a person to act on."
        }
      }
    }
  }
}
